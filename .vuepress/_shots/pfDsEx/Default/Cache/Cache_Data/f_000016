le) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n}\n.sub-navbar-container .toggle-series-button{\n    margin-left: 0.5rem;\n    margin-right: 0.5rem;\n    display: inline-block;\n    width: 1.5rem;\n    cursor: pointer;\n    vertical-align: middle;\n}\n@media (min-width: 768px){\n\n    .sub-navbar-container .toggle-series-button{\n        display: none;\n    }\n}\n.sub-navbar-container .toggle-series-button span{\n    margin-top: 0.375rem;\n    margin-bottom: 0.375rem;\n    display: block;\n    transform-origin: center;\n    --tw-bg-opacity: 1;\n    background-color: rgb(51 65 85 / var(--tw-bg-opacity));\n    transition-property: all;\n    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n    transition-duration: 500ms;\n}\n.sub-navbar-container .toggle-series-button span:is(.dark *){\n    --tw-bg-opacity: 1;\n    background-color: rgb(226 232 240 / var(--tw-bg-opacity));\n}\n.sub-navbar-container .toggle-series-button span {\n      height: 2px;\n      border-radius: 2px;\n    }\n.sub-navbar-container .toggle-series-button span:nth-of-type(1){\n    width: 0.75rem;\n}\n.sub-navbar-container .toggle-series-button span:nth-of-type(2){\n    margin-left: auto;\n    margin-right: auto;\n    width: 1.5rem;\n}\n.sub-navbar-container .toggle-series-button span:nth-of-type(3){\n    width: 1.25rem;\n}\n.theme-container .page-content,\n  .theme-container .theme-reco-md-content{\n    width: 100%;\n    padding-left: 1.5rem;\n    padding-right: 1.5rem;\n    border-top: 1px solid transparent;\n}\n.theme-container .page-content.theme-reco-md-content code, .theme-container .theme-reco-md-content.theme-reco-md-content code{\n    margin-left: 0.25rem;\n    margin-right: 0.25rem;\n    display: inline-block;\n    border-radius: 0.25rem;\n    background-color: rgb(93 103 232 / 0.1);\n    padding-left: 0.5rem;\n    padding-right: 0.5rem;\n    padding-top: 0.125rem;\n    padding-bottom: 0.125rem;\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n}\n.theme-container .page-content.theme-reco-md-content code:is(.dark *), .theme-container .theme-reco-md-content.theme-reco-md-content code:is(.dark *){\n    background-color: rgb(93 103 232 / 0.2);\n}\n.theme-container .page-content .theme-reco-md-content{\n    padding-left: 0px;\n    padding-right: 0px;\n}\n.theme-container .theme-reco-md-content{\n    margin-bottom: 4rem;\n}\n.theme-container .theme-reco-md-content h1{\n    display: none;\n}\n.theme-container .theme-reco-md-content a{\n    --tw-text-opacity: 1 !important;\n    color: rgb(93 103 232 / var(--tw-text-opacity)) !important;\n}\n.theme-container .theme-reco-md-content a:hover{\n    text-decoration-line: underline !important;\n}\n.theme-container .home-wrapper{\n    width: 100%;\n}\n.theme-container .home-wrapper .theme-reco-md-content{\n    margin-left: auto;\n    margin-right: auto;\n    max-width: 1280px;\n}\n.theme-container .contains-task-list{\n    list-style-type: none;\n    padding-left: 0px;\n}\n.theme-container .contains-task-list .contains-task-list{\n    padding-left: 0.75rem;\n}\n.theme-container .fade-slide-y-enter-active {\n    transition: all 0.3s ease;\n  }\n.theme-container .fade-slide-y-leave-active {\n    transition: all 0.3s cubic-bezier(1, 0.5, 0.8, 1);\n  }\n.theme-container .fade-slide-y-enter-from,\n  .theme-container .fade-slide-y-leave-to {\n    transform: translateY(10px);\n    opacity: 0;\n  }\n.theme-container .external-link-icon{\n    --tw-text-opacity: 1;\n    color: rgb(51 65 85 / var(--tw-text-opacity));\n}\n.theme-container .external-link-icon:is(.dark *){\n    --tw-text-opacity: 1;\n    color: rgb(226 232 240 / var(--tw-text-opacity));\n}\n\nh1:hover .header-anchor,\nh1:focus .header-anchor,\nh2:hover .header-anchor,\nh2:focus .header-anchor,\nh3:hover .header-anchor,\nh3:focus .header-anchor,\nh4:hover .header-anchor,\nh4:focus .header-anchor,\nh5:hover .header-anchor,\nh5:focus .header-anchor,\nh6:hover .header-anchor,\nh6:focus .header-anchor{\n    --tw-text-opacity: 1;\n    color: rgb(93 103 232 / var(--tw-text-opacity));\n    opacity: 1;\n}\n\na.header-anchor{\n    margin-top: 0.125rem;\n    font-size: 1rem;\n    line-height: 1.5rem;\n}\n\na.header-anchor span{\n    --tw-text-opacity: 1;\n    color: rgb(51 65 85 / var(--tw-text-opacity));\n}\n\na.header-anchor span:is(.dark *){\n    --tw-text-opacity: 1;\n    color: rgb(226 232 240 / var(--tw-text-opacity));\n}\n\na.header-anchor::before{\n    visibility: hidden;\n    margin-left: -0.75rem;\n    margin-right: 0.25rem;\n    content: '#';\n}\n\na.header-anchor:hover,\n  a.header-anchor:focus{\n    text-decoration-line: none;\n}\n\na.header-anchor:hover::before, a.header-anchor:focus::before{\n    visibility: visible;\n}\n\n.medium-zoom--opened .medium-zoom-overlay{\n    --tw-bg-opacity: 1 !important;\n    background-color: rgb(255 255 255 / var(--tw-bg-opacity)) !important;\n}\n\n.medium-zoom--opened .medium-zoom-overlay:is(.dark *){\n    --tw-bg-opacity: 1 !important;\n    background-color: rgb(22 22 23 / var(--tw-bg-opacity)) !important;\n}\n/**\n * 密度优化（2026-11-20）：整体缩小文本、收紧间距。\n * 只作用于文档正文（.theme-reco-md-content），不影响首页/侧栏/顶栏。\n * 本文件在 index.css 中位于 theme.css 之后，同优先级规则以本文件为准。\n */\n\n.theme-container .theme-reco-md-content {\n  /* 基础字号 16px -> 15px；inline 百分比字号（120%/125%/150% 等）随基数等比缩小 */\n  font-size: 15px;\n  line-height: 1.55;\n  /* body 全局 tracking-wider(0.05em) 在正文中收紧 */\n  letter-spacing: normal;\n  /* 原 @apply mb-16(4rem) -> 2.5rem */\n  margin-bottom: 2.5rem;\n}\n\n/* 段落间距：主题 base.css 的 p/ol/ul/table { my-6(1.5rem) + leading-8(2rem) }\n     是\"整页很空\"的最大来源（API 页几乎全由 <p> 堆成，相邻 p 之间空 3rem）。\n     收紧为 0.4rem / 1.6 行高 */\n\n.theme-container .theme-reco-md-content p,\n  .theme-container .theme-reco-md-content ol,\n  .theme-container .theme-reco-md-content ul {\n    margin: 0.4rem 0;\n    line-height: 1.6;\n  }\n\n/* 参数名行（inline margin-left:2em）：作为\"组头\"留出组间距，\n     与紧跟的说明行几乎贴合，形成\"名字+说明\"视觉成组 */\n\n.theme-container .theme-reco-md-content p[style*=\"margin-left:2em\"] {\n    margin-top: 0.55rem;\n    margin-bottom: 0.15rem;\n    line-height: 1.55;\n  }\n\n/* 参数说明行（inline margin-left:4em）：紧跟参数名；连续 4em 行是同组续行 */\n\n.theme-container .theme-reco-md-content p[style*=\"margin-left:4em\"] {\n    margin: 0.15rem 0;\n    line-height: 1.55;\n  }\n\n/* 标题间距与锚点偏移：彻底废弃主题的\"负 margin + padding-top\"锚点 hack。\n     原版 -mt-8/pt-12 差值 1rem；此前收紧时把差值压成 0（-4.75/4.75），\n     导致 h2 分隔线和 h3 文字贴死上一段，且标题盒子带主题的 z-index:-10\n     会整体滑入上一段下方。\n     现改为正常正间距 + scroll-margin-top（原生标准：锚点跳转时元素顶部\n     落在顶栏 4rem 之下 1rem），并恢复 z-index，标题不再压到任何背景之下 */\n\n.theme-container .theme-reco-md-content h2 {\n    margin-top: 1.9rem;\n    margin-bottom: 0.5em;\n    padding-top: 0;\n    z-index: auto;\n    scroll-margin-top: 5rem;\n  }\n\n.theme-container .theme-reco-md-content h3,\n  .theme-container .theme-reco-md-content h4,\n  .theme-container .theme-reco-md-content h5,\n  .theme-container .theme-reco-md-content h6 {\n    margin-top: 1.1rem;\n    margin-bottom: 0.4em;\n    padding-top: 0;\n    z-index: auto;\n    scroll-margin-top: 5rem;\n  }\n\n/* h2 分隔线（::before）的下边距 1.5rem -> 0.6rem */\n\n.theme-container .theme-reco-md-content h2::before {\n    margin-bottom: 0.6rem;\n  }\n/* ============================================================\n   布局可读性覆盖（在 theme.css / density.css 之后加载）\n   1. 左侧栏 series-container：加宽 + 长页面名允许换行（不再省略截断）\n   2. 右侧目录 page-catalog-container：高度约束可靠化，底部内容可滚动查看\n   3. 两栏滚动条：细且可见（默认半透明，悬停加深），亮暗色通用\n   ============================================================ */\n\n/* ---------- 左侧栏 ---------- */\n.series-container {\n  /* 原 w-64 (16rem) -> 18rem；配合下面收窄左右内边距，文本可用宽度 208px -> 256px */\n  width: 18rem;\n  padding-left: 1rem;   /* 原 p-6 (1.5rem) */\n  padding-right: 1rem;\n}\n\n/* 长页面名 / 组标题不再省略截断：允许换行，信息完整 */\n.series-container .series-group .series-heading span {\n  white-space: normal;\n  overflow: visible;\n  text-overflow: clip;\n  word-break: break-word;\n}\n.series-container .series-group h5.series-heading + ul li span.xicon-content {\n  white-space: normal;\n  overflow: visible;\n  text-overflow: clip;\n  word-break: break-word;\n}\n\n/* ---------- 右侧目录 ---------- */\n.page-catalog-container {\n  /* 原 w-60 (15rem) -> 16rem，减少条目标题的省略截断 */\n  width: 16rem;\n  /* 覆盖 h-full：高度交给 max-height 约束（原来 max-height 只在 md+ 生效） */\n  height: auto;\n  max-height: calc(100vh - 4rem);\n  overflow-y: auto;\n  /* 滚动到底时最后一条不贴视口底边 */\n  padding-bottom: 2rem;\n}\n\n/* 目录条目不再截断：原主题对 li 内所有 span（含 Xicons 的内/外两层）\n   施加 w-full + ellipsis + overflow-hidden + nowrap，长标题/API 名/\n   方法签名超出部分整体被裁。放开为允许换行，文本完整可见。\n   （特异性 0,1,3 与原规则相同，靠后加载取胜；也同时压过\n   Xicons 自带的 .xicon-container .xicon-content { text-nowrap }） */\n.page-catalog-container ul li span {\n  white-space: normal;\n  overflow: visible;\n  text-overflow: clip;\n  word-break: break-word;\n}\n\n/* ---------- 滚动条：细且可见 ---------- */\n.series-container,\n.page-catalog-container {\n  scrollbar-width: thin;                                /* Firefox */\n  scrollbar-color: rgba(125, 128, 145, 0.35) transparent;\n}\n/* 展开长列表（crs > ProjMethods 34 项）时滚动条出现不再挤窄内容宽度，消除布局跳动 */\n.series-container {\n  scrollbar-gutter: stable;\n}\n.series-container::-webkit-scrollbar,\n.page-catalog-container::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n.series-container::-webkit-scrollbar-track,\n.page-catalog-container::-webkit-scrollbar-track {\n  background: transparent;\n}\n.series-container::-webkit-scrollbar-thumb,\n.page-catalog-container::-webkit-scrollbar-thumb {\n  background: rgba(125, 128, 145, 0.35);\n  border-radius: 3px;\n}\n.series-container::-webkit-scrollbar-thumb:hover,\n.page-catalog-container::-webkit-scrollbar-thumb:hover {\n  background: rgba(125, 128, 145, 0.65);\n}\n\n/* ============================================================\n   API 页视觉增强（全站正文生效，保持官网紫色语言）\n   ============================================================ */\n\n/* 页面主标题：h1 的主题基础规则是 -mt-12 + pt-12（净间距 0，标题贴死\n   上方面包屑，且盒子带 z-index:-10 滑到面包屑底下）——归零，与面包屑的\n   间距由其 margin-bottom 提供；锚点偏移用 scroll-margin-top */\n.page-content .page-title {\n  margin-top: 0;\n  padding-top: 0;\n  z-index: auto;\n  scroll-margin-top: 5rem;\n}\n\n/* 页面主标题：紫色渐变下划线 */\n.page-content .page-title::after {\n  content: '';\n  display: block;\n  width: 4.5rem;\n  height: 3px;\n  margin-top: 0.9rem;\n  border-radius: 2px;\n  background: linear-gradient(90deg, #9298ED, rgba(146, 152, 237, 0));\n}\n\n/* ---------- 作者/日期行（PageInfo/PageMeta） ----------\n   文档站全部为 API/教程页面，作者与日期对查阅无信息量，整站隐藏 */\n.page-info,\n.page-meta .meta-item.last-updated {\n  display: none;\n}\n\n/* ---------- 标题字号分层 ----------\n   主题 base.css：h2 span text-2xl(24px)、h3 span text-xl(20px)、h4 span text-lg(18px)。\n   分节/成员标题与签名块、参数组标题挤在 18~24px 区间，层级无法分辨。\n   二次调整（用户反馈\"标题还没有 pill 显眼，头重脚轻\"）：标题整体加重——\n   章节(h2) 18.4px、成员(h3) 17.9px，均 700 粗体；h3 另加浅紫底条形成成员\n   区块感，权重明确压过 pill(13.6px 紫胶囊)。子级(h4) 16px。\n   紫色仅保留给代码身份（签名、类型、pill、链接） */\n.theme-reco-md-content h2 span {\n  font-size: 1.15rem;\n  font-weight: 700;\n}\n.theme-reco-md-content h3 span {\n  font-size: 1.12rem;\n  font-weight: 700;\n}\n.theme-reco-md-content h4 span {\n  font-size: 1rem;\n}\n/* 标题文字色：正文所有 <a> 被 theme.css 染紫（!important），标题的\n   header-anchor 也是 <a>，其内部 span 会继承紫色 -> 显式改回标题深灰\n   （reco palette 的 text-heavier，与主题标题一致） */\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor span {\n  color: rgb(15, 23, 42);\n}\n.dark .theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor span {\n  color: rgb(255, 255, 255);\n}\n\n/* h3 成员标题：浅紫底条 + 左缘紫色圆角竖条。\n   成员头是页面最高频的\"锚\"，加极浅紫底条形成区块感（与 pill、正文拉开权重），\n   竖条贴底条左缘。竖条垂直定位用 top:50% + translateY(-50%) 几何居中于\n   行盒（此前 top:0.24em 手调值在用户端观感偏上） */\n.theme-reco-md-content h3 {\n  position: relative;\n  padding: 0.3rem 0.6rem 0.3rem 0.75rem;\n  border-radius: 6px;\n  background: rgba(146, 152, 237, 0.08);\n}\n.theme-reco-md-content h3::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 50%;\n  height: 1.15em;\n  width: 4px;\n  border-radius: 2px;\n  background: #9298ed;\n  transform: translateY(-50%);\n  transition: opacity 0.25s;\n}\n/* 悬停成员标题：竖条淡出，让位给 header-anchor 的 # 提示（同一区域切换） */\n.theme-reco-md-content h3:hover::before {\n  opacity: 0;\n}\n.dark .theme-reco-md-content h3 {\n  background: rgba(146, 152, 237, 0.13);\n}\n\n/* Optional:/Returns:/Parameters:/References: 参数组标题：胶囊 pill 标签。\n   这类 p 带 inline style \"font-size: 120%;color:#9298ED;font-weight: bold;\"，\n   inline 的 color/font-size 需要 !important 才能覆盖。\n   之前与 h3 同款\"紫字+竖条\"，视觉上和成员标题（h3）无法区分，现改为\n   小号胶囊标签，与\"章节(h2) -> 成员(h3) -> 参数组(pill)\"层级语言一致 */\n.theme-reco-md-content p[style*=\"#9298ED\"] {\n  display: inline-block;\n  font-size: 0.85rem !important;\n  color: #616AE5 !important;\n  background: #EFF0FC;\n  padding: 0.15rem 0.75rem;\n  border-radius: 999px;\n  margin: 0.8rem 0 0.5rem;\n}\n.theme-reco-md-content p[style*=\"#9298ED\"]::before {\n  content: none;\n}\n.dark .theme-reco-md-content p[style*=\"#9298ED\"] {\n  color: #a6acf2 !important;\n  background: rgba(146, 152, 237, 0.16);\n}\n\n/* ---------- 签名块卡片化 ----------\n   类/函数签名块：inline 背景 #EFF0FC（顶层签名）/ #F4F4F5（成员签名），无内边距，\n   文字贴边；两块一紫一灰，同页出现时像两种组件。统一为浅紫卡 + 内边距 + 圆角。\n   内部字号（inline font-size: 150%/130%/125%/120%）按块降档，签名不再喧宾夺主 */\n.theme-reco-md-content span[style*=\"background-color:#EFF0FC\"],\n.theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] {\n  background-color: #EFF0FC !important;\n  border-radius: 8px;\n  padding: 0.7rem 1rem;\n  margin: 0.55rem 0;\n}\n.theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] > span[style*=\"font-size:150%\"] {\n  font-size: 135% !important;\n}\n.theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] > span[style*=\"font-size:130%\"] {\n  font-size: 115% !important;\n}\n.theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] > span[style*=\"font-size:125%\"] {\n  font-size: 112% !important;\n}\n.theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] > span[style*=\"font-size:120%\"] {\n  font-size: 108% !important;\n}\n\n/* 暗色模式：签名块底色改暗紫（浅色内部字才可读） */\n.dark .theme-reco-md-content span[style*=\"background-color:#EFF0FC\"],\n.dark .theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] {\n  background-color: rgba(146, 152, 237, 0.14) !important;\n}\n\n/* 暗色模式下原版黑/灰字在暗底上不可读（inline color 需 !important） */\n.dark .theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] span[style*=\"color:black\"],\n.dark .theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] span[style*=\"color:black\"] {\n  color: #d5d7e8 !important;\n}\n.dark .theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] span[style*=\"color:gray\"],\n.dark .theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] span[style*=\"color:gray\"] {\n  color: #9aa0b8 !important;\n}\n.dark .theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] span[style*=\"#616AE5\"],\n.dark .theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] span[style*=\"#616AE5\"] {\n  color: #a6acf2 !important;\n}\n.dark .theme-reco-md-content span[style*=\"background-color:#EFF0FC\"] span[style*=\"#48566B\"],\n.dark .theme-reco-md-content span[style*=\"background-color:#F4F4F5\"] span[style*=\"#48566B\"] {\n  color: #b8c0e8 !important;\n}\n\n/* ---------- 顶层路径标题（gma.xxx.ClassName） ----------\n   inline \"font-size: 120%;font-weight: bold;\"（无 color，与 684 处参数组标题的\n   \"#9298ED\" 变体可精确区分）。类/函数在库中的定位行：等宽字 + 主题紫灰调，\n   1rem 与正文等大保证可读，紫色系呼应\"代码身份\"语言但不与 pill 抢眼 */\n.theme-reco-md-content p[style*=\"font-size:120%\"][style*=\"font-weight:bold\"]:not([style*=\"9298ED\"]) {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 1rem !important;\n  font-weight: 600 !important;\n  color: #636aa8 !important;\n  letter-spacing: 0.01em;\n  margin: 0.15rem 0 0.55rem;\n}\n.dark .theme-reco-md-content p[style*=\"font-size:120%\"][style*=\"font-weight:bold\"]:not([style*=\"9298ED\"]) {\n  color: #a4aae6 !important;\n}\n\n/* 表格：表头底色 + 斑马纹 + 悬停高亮 */\n.theme-reco-md-content table {\n  border-collapse: collapse;\n  width: 100%;\n  margin: 1.1rem 0;\n  font-size: 0.92em;\n}\n.theme-reco-md-content th,\n.theme-reco-md-content td {\n  border: 1px solid rgba(126, 130, 160, 0.22);\n  padding: 0.45rem 0.8rem;\n  text-align: left;\n  vertical-align: top;\n}\n.theme-reco-md-content th {\n  background: rgba(146, 152, 237, 0.12);\n  font-weight: 600;\n}\n.theme-reco-md-content tbody tr {\n  transition: background-color 0.25s;\n}\n.theme-reco-md-content tbody tr:nth-child(2n) {\n  background: rgba(126, 130, 160, 0.05);\n}\n.theme-reco-md-content tbody tr:hover {\n  background: rgba(146, 152, 237, 0.09);\n}\n\n/* 引用块 */\n.theme-reco-md-content blockquote {\n  margin: 1rem 0;\n  padding: 0.6rem 1rem;\n  border-left: 3px solid #9298ed;\n  border-radius: 0 6px 6px 0;\n  background: rgba(146, 152, 237, 0.07);\n}\n.theme-reco-md-content blockquote p {\n  margin: 0;\n}\n\n/* 分隔线：紫色渐隐 */\n.theme-reco-md-content hr {\n  border: none;\n  height: 1px;\n  margin: 2rem 0;\n  background: linear-gradient(90deg, rgba(146, 152, 237, 0.45), rgba(146, 152, 237, 0));\n}\n\n/* ---------- 暗色模式适配（darkMode: class） ---------- */\n.dark .theme-reco-md-content th {\n  background: rgba(146, 152, 237, 0.15);\n}\n.dark .theme-reco-md-content th,\n.dark .theme-reco-md-content td {\n  border-color: rgba(255, 255, 255, 0.12);\n}\n.dark .theme-reco-md-content tbody tr:nth-child(2n) {\n  background: rgba(255, 255, 255, 0.04);\n}\n.dark .theme-reco-md-content tbody tr:hover {\n  background: rgba(146, 152, 237, 0.14);\n}\n.dark .theme-reco-md-content blockquote {\n  background: rgba(146, 152, 237, 0.1);\n}\n\n/* ---------- 左右侧目录行距收紧（用户反馈行距过大） ----------\n   左侧栏条目原 py-1 + leading-7（28px 行高 + 8px 上下 padding ≈ 36px/行）；\n   右侧目录 depth_2 条目原 py-4（相邻条目间空 32px）。选择器路径与原版\n   一致，本文件后加载覆盖 */\n/* ---------- 左侧栏行距（原版 36px/行 -> 收紧版 27px/行过挤 -> 回调 32px/行） ---------- */\n.series-container a.series-item {\n  padding-top: 0.3rem;\n  padding-bottom: 0.3rem;\n  line-height: 1.6;\n}\n.series-container .series-group .series-heading {\n  margin-bottom: 1rem;\n}\n.series-container .series-group h5.series-heading + ul {\n  padding-top: 0.9rem;\n}\n.series-container .series-group h6.series-heading {\n  padding-top: 0.65rem;\n}\n.series-container .series-group {\n  padding-bottom: 1.6rem;\n}\n.series-container .series-group:not(:first-of-type) h5.series-heading {\n  margin-top: 1.2rem;\n}\n.page-catalog-container .page-catalog-menu-depth_2 {\n  padding-top: 0.4rem;\n  padding-bottom: 0.4rem;\n}\n.page-catalog-container .page-catalog-menu-depth_3 {\n  padding-top: 0.25rem;\n  padding-bottom: 0.25rem;\n}\n\n/* ---------- 标题锚点（header-anchor）修正 ----------\n   主题把 md 正文所有 <a> 染紫并 hover 下划线（theme.css:19-21，带 !important）。\n   标题的 header-anchor 也是 <a>：hover 下划线按 16px 位置绘制会横穿标题文字\n   （用户截图中的横线）——下划线禁用；# 锚点提示按用户要求恢复。\n   原版机制：::before content '#' + @apply invisible（visibility:hidden）+\n   hover 时 visible。此前只切 opacity 而漏掉 visibility -> # 永不渲染（已踩坑）。\n   本规则双通道覆盖（opacity + visibility），margin 随字号缩放、悬停范围\n   扩大到整个标题行；h3 竖条同区域淡出让位（见上方）。\n   正文普通链接行为不变。（特异性 0,3,2 > 原版 hover 规则 0,2,2，且本文件后加载） */\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor {\n  text-decoration: none !important;\n}\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor:hover,\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor:focus {\n  text-decoration: none !important;\n}\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor::before {\n  content: '#' !important;\n  color: #b9bed3;\n  font-size: 0.8em;\n  font-weight: 400;\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity 0.25s, visibility 0s linear 0.25s;\n}\n/* h3（有底条）：# 收进底条左缘、竖条原位附近（em 相对 ::before 自身 0.8em 字号） */\n.theme-reco-md-content h3 a.header-anchor::before {\n  margin-left: -0.75em;\n  margin-right: 0.35em;\n}\n/* 其余标题（无底条）：# 悬在文字左侧外，约原版 -ml-3 的位置 */\n.theme-reco-md-content :is(h2, h4, h5, h6) a.header-anchor::before {\n  margin-left: -0.8em;\n  margin-right: 0.35em;\n}\n/* 悬停标题 / 键盘聚焦锚点时显现 */\n.theme-reco-md-content :is(h2, h3, h4, h5, h6):hover a.header-anchor::before,\n.theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor:focus::before {\n  opacity: 1;\n  visibility: visible;\n  transition: opacity 0.25s, visibility 0s;\n}\n.dark .theme-reco-md-content :is(h2, h3, h4, h5, h6) a.header-anchor::before {\n  color: #8e93ad;\n}\n\n/* ---------- Navbar 下拉菜单行距（API reference 等） ----------\n   菜单 li 字号 16px（.link 自身 14px），主题全局 line-height:2rem(32px)\n   使 inline-block 的 .link(20px) 基线对齐后剩余 12px 全变条目间隙。\n   三轮定稿 line-height:1.75 -> 行盒 28px、间隙 8px（12px 过松/24.8px 过挤） */\n.dropdown-link .dropdown-link__container,\n.dropdown-link .dropdown-link__container li {\n  line-height: 1.75;\n}\n\n/* ---------- 侧栏二级折叠组(crs > ProjMethods) ----------\n   sidebar 配置改为嵌套对象 + collapsable: true;组件 SeriesItem.js 已放开\n   二级组折叠交互、激活自动展开。此处只管视觉:\n   标题行(14px/600,与一级组区分)、组标题链接、嵌套列表缩进与左参考线 */\n.series-container li > .series-group {\n  padding-bottom: 0.4rem;\n}\n.series-container li > .series-group h6.series-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 0.15rem;\n  margin-bottom: 0.4rem;\n  padding-top: 0.35rem;\n  font-size: 0.875rem;\n  font-weight: 600;\n  line-height: 1.6;\n  color: #5f6079;\n  cursor: pointer;\n}\n/* 组标题文本即总览页链接时,折叠只由箭头触发,标题行本身不是点击区 */\n.series-container li > .series-group h6.series-heading:has(a.link) {\n  cursor: default;\n}\n.series-container li > .series-group h6.series-heading.active {\n  color: #616ae5;\n}\n.series-container li > .series-group h6.series-heading .series-group-title-link {\n  color: inherit;\n  font-weight: 600;\n  text-decoration: none;\n}\n.series-container li > .series-group h6.series-heading .series-group-title-link:hover {\n  color: #616ae5;\n}\n.series-container li > .series-group h6.series-heading .arrow {\n  cursor: pointer;\n}\n/* 嵌套列表:与一级列表一致的水平缩进 + 左虚线参考线(行距沿用 a.series-item 32px/行) */\n.series-container li > .series-group h6.series-heading + ul {\n  margin-top: 0.1